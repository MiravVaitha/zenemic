{
  "expo": {
    "name": "Zenemic",
    "slug": "zenemic",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "zenemic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zenemic.app"
    },
    "android": {
      "package": "com.zenemic.app"
    },
    "splash": {
      "backgroundColor": "#f8f6f1",
      "resizeMode": "contain"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zenemic to access your photos so you can add them to a shared event album."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Zenemic to access your photos so you can add them to a shared event album.",
          "savePhotosPermission": "Allow Zenemic to save event photos to your device.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
